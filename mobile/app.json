{
  "expo": {
    "name": "Couchy",
    "slug": "couchy",
    "scheme": "couchy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Couchy listens when you hold the button to talk to your companion.",
        "NSPhotoLibraryUsageDescription": "Choose a photo of the medicine so it is easy to recognize."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2EFE0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "app.couchy.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#2F6F5E"
        }
      ],
      "expo-image-picker",
      "./plugins/withAlarmActivity",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c8be6c5d-fe46-4f50-a7a4-0336168582e0"
      }
    }
  }
}
